{
  "name": "Auto-Sync Results Visibility on Session Status Change",
  "description": "When a Session status changes to Official or Locked, automatically sync Result.is_public for all results in that session. Also fires on rollback (Provisional/Draft) to retract visibility.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Session"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_results_visibility_on_session_status_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncResultsVisibilityFromSession",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncResultsVisibilityFromSession"
  }
}