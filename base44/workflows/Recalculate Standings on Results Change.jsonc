{
  "name": "Recalculate Standings on Results Change",
  "description": "Automatically recalculates series standings whenever a Result is created or updated",
  "trigger": {
    "condition": "${ (.trigger.data.series_id != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "Results"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recalculate_standings_on_results_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recalculateStandings",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recalculateStandings"
  }
}