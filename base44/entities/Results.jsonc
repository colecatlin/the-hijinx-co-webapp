{
  "name": "Results",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "Reference to Driver"
    },
    "program_id": {
      "type": "string",
      "description": "Reference to DriverProgram"
    },
    "event_id": {
      "type": "string",
      "description": "Reference to Event"
    },
    "session_id": {
      "type": "string",
      "description": "Reference to Session (optional \u2014 for T&S integration)"
    },
    "event_day_id": {
      "type": "string",
      "description": "Reference to EventDay \u2014 copied from session at result creation time"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "Practice",
        "Qualifying",
        "Heat",
        "LCQ",
        "Final"
      ],
      "description": "Type of session"
    },
    "heat_number": {
      "type": "number",
      "description": "Heat number (1, 2, 3, 4, etc.) when session_type is Heat"
    },
    "series_id": {
      "type": "string",
      "description": "Reference to Series (denormalized for quick lookup)"
    },
    "series_class_id": {
      "type": "string",
      "description": "Reference to SeriesClass (denormalized for quick lookup)"
    },
    "team_id": {
      "type": "string",
      "description": "Reference to Team at time of race"
    },
    "position": {
      "type": "number",
      "description": "Finishing position (1, 2, 3, etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Running",
        "DNF",
        "DNS",
        "DSQ",
        "DNP"
      ],
      "description": "Result status code (race outcome status)"
    },
    "status_state": {
      "type": "string",
      "enum": [
        "Draft",
        "Provisional",
        "Official",
        "Locked"
      ],
      "default": "Draft",
      "description": "Publication state of the result"
    },
    "laps_completed": {
      "type": "number",
      "description": "Laps completed"
    },
    "best_lap_time_ms": {
      "type": "number",
      "description": "Best lap time in milliseconds"
    },
    "points": {
      "type": "number",
      "description": "Points earned"
    },
    "points_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this result awards points \u2014 copied from session"
    },
    "points_type": {
      "type": "string",
      "enum": [
        "none",
        "qualifying",
        "final"
      ],
      "default": "none",
      "description": "Type of points \u2014 copied from session"
    },
    "points_rule": {
      "type": "string",
      "description": "Points rule identifier \u2014 copied from session"
    },
    "round_number": {
      "type": "number",
      "description": "Championship round number \u2014 copied from session (Finals only)"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "Whether result is published for public viewing"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When result was published"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Derived visibility field"
    },
    "result_identity_key": {
      "type": "string",
      "description": "Stable deduplication key"
    },
    "normalized_result_key": {
      "type": "string",
      "description": "Deterministic normalized key"
    },
    "notes": {
      "type": "string",
      "description": "Additional result notes"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "R9CS: Whether this record is archived"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "R9CS: When this record was archived"
    },
    "archived_by": {
      "type": "string",
      "description": "R9CS: User ID who archived this record"
    },
    "archive_reason": {
      "type": "string",
      "description": "R9CS: Reason for archiving"
    },
    "is_historical": {
      "type": "boolean",
      "default": false,
      "description": "R9EA: True for results created from historical import rather than live operations"
    },
    "record_status": {
      "type": "string",
      "enum": [
        "official",
        "verified",
        "historical_verified",
        "manual",
        "partial",
        "estimated",
        "under_review",
        "superseded"
      ],
      "default": "official",
      "description": "R9EA: Authority level of this result record"
    },
    "source_authority_level": {
      "type": "string",
      "enum": [
        "official",
        "semi_official",
        "third_party",
        "reconstructed",
        "estimated"
      ],
      "description": "R9EA: Source authority classification"
    },
    "source_name": {
      "type": "string",
      "description": "R9EA: Human-readable source name (e.g. 'TORC 2019 Results Archive')"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "live_ops",
        "csv_import",
        "pdf_import",
        "timing_sheet",
        "series_roster",
        "website_scrape",
        "manual_entry",
        "api_feed",
        "historical_archive",
        "driver_self_report",
        "official_verification"
      ],
      "description": "R9EA: Source type classification"
    },
    "confidence_score": {
      "type": "number",
      "description": "R9EA: 0-100 confidence in this result record"
    },
    "result_completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "position_only",
        "points_only",
        "unknown"
      ],
      "default": "complete",
      "description": "R9EA: How complete this result record is"
    },
    "supersedes_result_id": {
      "type": "string",
      "description": "R9EA: ID of an earlier lower-confidence result this record supersedes"
    },
    "superseded_by_result_id": {
      "type": "string",
      "description": "R9EA: ID of a higher-confidence result that supersedes this one"
    },
    "revision_notes": {
      "type": "string",
      "description": "R9EA: Notes on revisions or corrections to this result"
    },
    "import_run_id": {
      "type": "string",
      "description": "R9EA: ImportSourceRun.id that created this result"
    },
    "racecore_id": {
      "type": "string",
      "description": "Immutable RaceCore ID (RSLT + 9 digits). Backend-generated. Nullable in Phase 1 \u2014 not generated yet."
    },
    "entry_id": {
      "type": "string",
      "description": "Reference to Entry. Nullable in Phase 1 \u2014 populated during backfill. Links this result to the event-specific entry record."
    },
    "participation_id": {
      "type": "string",
      "description": "Reference to SeasonParticipation. Nullable in Phase 1 \u2014 populated during backfill. Derived through Entry."
    }
  },
  "required": [
    "driver_id",
    "event_id"
  ]
}