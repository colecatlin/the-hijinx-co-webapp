{
  "name": "Organization",
  "type": "object",
  "description": "Generic organization record for org types without a dedicated racing entity (Sponsor, Vendor, Manufacturer, OEM, broadcast partners, venues, sanctioning bodies, etc.). The Organization Platform registry routes each `type` to this entity. Teams, Tracks, Series, and MediaOutlets keep their own entities; everything else lives here so the framework stays configuration-driven. Phase 17A adds deterministic normalization fields for canonical Sponsor/Partner identity resolution.",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Sponsor",
        "Vendor",
        "Manufacturer",
        "OEM",
        "BroadcastPartner",
        "Venue",
        "SanctioningBody",
        "MarketingAgency",
        "SafetyCrew",
        "HospitalityPartner",
        "RetailPartner",
        "TechnologyProvider",
        "League",
        "Club",
        "Association",
        "Other"
      ],
      "description": "Organization type discriminator. Drives registry behavior."
    },
    "name": {
      "type": "string",
      "description": "Organization name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "description": {
      "type": "string",
      "description": "Public description"
    },
    "tagline": {
      "type": "string",
      "description": "Short headline/identity statement"
    },
    "website_url": {
      "type": "string",
      "description": "Primary website URL"
    },
    "location_city": {
      "type": "string"
    },
    "location_state": {
      "type": "string"
    },
    "location_country": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo image URL"
    },
    "banner_url": {
      "type": "string",
      "description": "Banner image URL"
    },
    "primary_color": {
      "type": "string",
      "description": "Primary brand color (hex)"
    },
    "secondary_color": {
      "type": "string",
      "description": "Secondary brand color (hex)"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "visibility_status": {
      "type": "string",
      "enum": [
        "draft",
        "live"
      ],
      "default": "draft",
      "description": "Controls public profile visibility within the platform."
    },
    "operational_status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Upcoming"
      ],
      "default": "Active"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User ID of the organization owner"
    },
    "numeric_id": {
      "type": "string",
      "description": "8-digit numeric access code"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_source": {
      "type": "string"
    },
    "normalized_name": {
      "type": "string",
      "description": "Phase 17A: Normalized lowercase name for deterministic deduplication. Computed from name via normalizeOrganizationName()."
    },
    "canonical_slug": {
      "type": "string",
      "description": "Phase 17A: Canonical slug derived from normalized name for deduplication."
    },
    "canonical_key": {
      "type": "string",
      "description": "Phase 17A: Deterministic internal organization identity key (Organization:<normalized_name> or Organization:<external_uid>)."
    },
    "external_uid": {
      "type": "string",
      "description": "Phase 17A: Trusted external organization identifier for deterministic resolution."
    },
    "sync_last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Phase 17A: External sync timestamp."
    },
    "industry": {
      "type": "string",
      "description": "Phase 17A: Public/commercial industry classification (e.g. Motor Oil, Energy Drink, Tires)."
    }
  },
  "required": [
    "name",
    "type"
  ]
}