{
  "name": "CultureBlock",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Block title displayed on the card"
    },
    "label": {
      "type": "string",
      "description": "Small label shown at the top of the block (e.g. 'Culture', 'Media')"
    },
    "description": {
      "type": "string",
      "maxLength": 120,
      "description": "Optional short description text (max 120 characters)"
    },
    "image_url": {
      "type": "string",
      "description": "Background image URL"
    },
    "use_glass_overlay": {
      "type": "boolean",
      "default": false,
      "description": "When enabled, applies a frosted glass overlay style on top of the image (or as the background if no image)"
    },
    "link_url": {
      "type": "string",
      "description": "URL to navigate to when block is clicked"
    },
    "link_label": {
      "type": "string",
      "description": "CTA link text (e.g. 'Shop Apparel')"
    },
    "accent_color": {
      "type": "string",
      "description": "Hex color for hover glow accent (e.g. #00FFDA)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower = first)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this block is visible on the homepage"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}