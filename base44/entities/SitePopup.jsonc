{
  "name": "SitePopup",
  "type": "object",
  "description": "Admin-managed landing pop-up shown to visitors on the Home page. Dismissed once per browser session via sessionStorage. Used for beta notices, announcements, and promotional CTAs.",
  "properties": {
    "title": {
      "type": "string",
      "description": "Pop-up headline"
    },
    "body": {
      "type": "string",
      "description": "Pop-up body text (supports plain text or basic HTML)"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Optional cover image URL displayed at the top of the pop-up"
    },
    "cta_text": {
      "type": "string",
      "description": "Optional call-to-action button label"
    },
    "cta_url": {
      "type": "string",
      "description": "Optional URL the CTA button links to"
    },
    "subscribe_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, renders an email subscribe form in the pop-up. Submissions create a NewsletterSubscriber record."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Lifecycle status. Only 'published' pop-ups are shown to visitors."
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Display priority \u2014 lower numbers appear first. When multiple pop-ups are active, the lowest priority value is shown."
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional schedule start. Pop-up is not shown before this date."
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional schedule end. Pop-up is not shown after this date."
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Display ordering (lower = earlier)"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}