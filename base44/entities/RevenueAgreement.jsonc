{
  "name": "RevenueAgreement",
  "type": "object",
  "description": "Phase 17C: RevenueAgreement now optionally supports a 'sponsorship' agreement_type with linked_sponsorship_id. All existing agreement types and behavior are preserved unchanged. Sponsorship agreements are an OPTIONAL new agreement type \u2014 linked_sponsorship_id is only required when agreement_type == 'sponsorship'.",
  "properties": {
    "agreement_type": {
      "type": "string",
      "enum": [
        "media_asset_license",
        "assignment_payment",
        "merch_revenue_share",
        "creator_fund",
        "outlet_revenue_share",
        "sponsored_content",
        "sponsorship"
      ],
      "description": "Type of revenue agreement. Phase 17C adds 'sponsorship' for commercial sponsorship agreements linked to a Sponsorship record."
    },
    "linked_asset_id": {
      "type": "string",
      "description": "Optional MediaAsset ID"
    },
    "linked_assignment_id": {
      "type": "string",
      "description": "Optional MediaAssignment ID"
    },
    "linked_story_id": {
      "type": "string",
      "description": "Optional OutletStory ID"
    },
    "linked_outlet_id": {
      "type": "string",
      "description": "Optional MediaOutlet ID"
    },
    "linked_profile_id": {
      "type": "string",
      "description": "Optional MediaProfile ID"
    },
    "linked_request_id": {
      "type": "string",
      "description": "Optional MediaRequest ID"
    },
    "linked_sponsorship_id": {
      "type": "string",
      "description": "Phase 17C: Optional Sponsorship ID. Required when agreement_type == 'sponsorship'. References Sponsorship.id. Must point to a non-archived Sponsorship with a valid Organization."
    },
    "creator_profile_id": {
      "type": "string",
      "description": "MediaProfile ID of the creator party"
    },
    "media_outlet_id": {
      "type": "string",
      "description": "MediaOutlet ID if outlet is a party"
    },
    "platform_share_percent": {
      "type": "number",
      "description": "Platform's percentage of gross revenue (0-100)"
    },
    "creator_share_percent": {
      "type": "number",
      "description": "Creator's percentage of gross revenue (0-100)"
    },
    "outlet_share_percent": {
      "type": "number",
      "description": "Outlet's percentage of gross revenue (0-100)"
    },
    "flat_fee_amount": {
      "type": "number",
      "description": "Optional flat fee in cents (overrides percentage for flat-fee agreements)"
    },
    "currency": {
      "type": "string",
      "default": "usd",
      "description": "ISO currency code"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_acceptance",
        "active",
        "revoked",
        "completed"
      ],
      "default": "draft",
      "description": "Agreement lifecycle status"
    },
    "effective_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this agreement becomes effective"
    },
    "effective_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this agreement expires"
    },
    "notes": {
      "type": "string",
      "description": "Admin or editorial notes"
    }
  },
  "required": [
    "agreement_type",
    "platform_share_percent",
    "creator_share_percent",
    "outlet_share_percent",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}