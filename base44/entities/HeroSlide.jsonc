{
  "name": "HeroSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string",
      "description": "Small label above title (e.g. 'New Collection')"
    },
    "image_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "cta_label": {
      "type": "string",
      "description": "CTA button text"
    },
    "cta_url": {
      "type": "string",
      "description": "CTA link URL"
    },
    "cta_secondary_label": {
      "type": "string"
    },
    "cta_secondary_url": {
      "type": "string"
    },
    "text_position": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}