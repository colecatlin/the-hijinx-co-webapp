{
  "name": "HeroSlide",
  "type": "object",
  "properties": {
    "headline_line1": {
      "type": "string",
      "description": "Primary headline text (line 1)"
    },
    "headline_line2": {
      "type": "string",
      "description": "Secondary headline text (line 2)"
    },
    "subtext": {
      "type": "string",
      "description": "Supporting subtext below the headline"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image",
      "description": "Type of background media"
    },
    "background_url": {
      "type": "string",
      "description": "Background image or video URL"
    },
    "cta1_label": {
      "type": "string",
      "description": "Primary CTA button text"
    },
    "cta1_url": {
      "type": "string",
      "description": "Primary CTA link URL"
    },
    "cta2_label": {
      "type": "string",
      "description": "Secondary CTA button text"
    },
    "cta2_url": {
      "type": "string",
      "description": "Secondary CTA link URL"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this slide is visible on the homepage"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower = earlier)"
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is sample/demo data"
    }
  },
  "required": [
    "headline_line1"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}