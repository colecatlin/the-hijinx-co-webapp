{
  "name": "HeroSlide",
  "type": "object",
  "properties": {
    "headline_line1": {
      "type": "string",
      "description": "First line of the headline"
    },
    "headline_line2": {
      "type": "string",
      "description": "Second line of the headline"
    },
    "subtext": {
      "type": "string",
      "description": "Subheadline / supporting text"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image",
      "description": "Type of background media"
    },
    "background_url": {
      "type": "string",
      "description": "URL for background image or video (optional \u2014 can be uploaded)"
    },
    "cta1_label": {
      "type": "string",
      "description": "Primary CTA button label"
    },
    "cta1_url": {
      "type": "string",
      "description": "Primary CTA button URL"
    },
    "cta2_label": {
      "type": "string",
      "description": "Secondary CTA button label (optional)"
    },
    "cta2_url": {
      "type": "string",
      "description": "Secondary CTA button URL (optional)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order \u2014 lower number appears first"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this slide is visible on the homepage"
    }
  },
  "required": [
    "headline_line1"
  ]
}