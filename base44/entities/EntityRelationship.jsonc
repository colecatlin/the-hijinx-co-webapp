{
  "name": "EntityRelationship",
  "type": "object",
  "description": "Parent-child relationship between two Entity records for permissions and collaboration",
  "properties": {
    "parent_entity_id": {
      "type": "string",
      "description": "References Entity.id of the parent (e.g. Track, Series)"
    },
    "child_entity_id": {
      "type": "string",
      "description": "References Entity.id of the child (e.g. Event)"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "hosts",
        "sanctions",
        "manages",
        "owns",
        "collaborates"
      ],
      "description": "Nature of the relationship"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "revoked"
      ],
      "default": "proposed",
      "description": "Lifecycle status of the relationship"
    },
    "proposed_by_user_id": {
      "type": "string",
      "description": "User who proposed this relationship"
    },
    "accepted_by_user_id": {
      "type": "string",
      "description": "User who accepted this relationship"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "parent_entity_id",
    "child_entity_id",
    "relationship_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}