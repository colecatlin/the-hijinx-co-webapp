{
  "name": "Home1Settings",
  "type": "object",
  "description": "Presentation configuration for the new HIJINX homepage (Home1). Single active record (is_active=true). Stores draft and published configuration separately \u2014 the public page reads only published; the Management editor works against draft. Does NOT duplicate platform records (Events, OutletStories, Shopify products, ActivityFeed) \u2014 stores references and presentation overrides only.",
  "properties": {
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Singleton marker \u2014 the active Home1 settings record"
    },
    "draft": {
      "type": "object",
      "description": "Full draft section configuration (hero, next_up, one_brand, ecosystem, whats_happening, from_the_outlet, featured_apparel, closing_cta). Edited by admins; not shown publicly until published."
    },
    "published": {
      "type": "object",
      "description": "Full published section configuration. The public Home1 page reads this. Copied from draft on publish."
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the published configuration was last published"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the draft was last saved"
    },
    "updated_by_user_id": {
      "type": "string",
      "description": "User ID of the last admin to save the draft or publish"
    },
    "has_unpublished_changes": {
      "type": "boolean",
      "default": false,
      "description": "True when draft differs from published \u2014 set on draft save, cleared on publish"
    }
  },
  "required": [
    "is_active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}