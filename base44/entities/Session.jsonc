{
  "name": "Session",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Reference to Event (required)"
    },
    "event_class_id": {
      "type": "string",
      "description": "Reference to EventClass"
    },
    "series_class_id": {
      "type": "string",
      "description": "Reference to SeriesClass"
    },
    "event_day_id": {
      "type": "string",
      "description": "Reference to EventDay"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "Practice",
        "Qualifying",
        "Heat",
        "LCQ",
        "Feature",
        "Final",
        "Time Attack",
        "Other"
      ],
      "description": "Type of session"
    },
    "name": {
      "type": "string",
      "description": "Session name"
    },
    "session_number": {
      "type": "number",
      "description": "Session number within class group"
    },
    "round_number": {
      "type": "number",
      "description": "Round number \u2014 only used for Final sessions that award championship points"
    },
    "round_label": {
      "type": "string",
      "description": "Optional display label for the round"
    },
    "points_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this session awards points toward standings"
    },
    "points_type": {
      "type": "string",
      "enum": [
        "none",
        "qualifying",
        "final"
      ],
      "default": "none",
      "description": "Type of points awarded"
    },
    "points_rule": {
      "type": "string",
      "description": "Points rule identifier"
    },
    "run_order": {
      "type": "number",
      "default": 0,
      "description": "Execution order for race day timeline"
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled start time"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Duration in minutes"
    },
    "laps": {
      "type": "number",
      "description": "Number of laps"
    },
    "input_source": {
      "type": "string",
      "enum": [
        "Manual",
        "CSV",
        "API"
      ],
      "default": "Manual",
      "description": "Source of session data"
    },
    "advancement_rules": {
      "type": "string",
      "description": "Rules for driver advancement"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Scheduled",
        "Live",
        "Completed",
        "Official",
        "Locked",
        "Archived"
      ],
      "default": "Draft",
      "description": "Session lifecycle status: Draft \u2192 Scheduled \u2192 Live \u2192 Completed \u2192 Official \u2192 Locked"
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "Whether session is locked from editing"
    },
    "live_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this session was set to Live"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this session was completed"
    },
    "is_historical": {
      "type": "boolean",
      "default": false,
      "description": "Marks sessions created for historical/reference result entry workflows."
    },
    "normalized_name": {
      "type": "string",
      "description": "Normalized lowercase name for deduplication"
    },
    "canonical_slug": {
      "type": "string",
      "description": "Canonical slug derived from normalized name"
    },
    "canonical_key": {
      "type": "string",
      "description": "Canonical unique key: session:{event_id}:{normalized_name}"
    },
    "normalized_session_key": {
      "type": "string",
      "description": "Composite dedup key"
    },
    "external_uid": {
      "type": "string",
      "description": "UID from external data source for deduplication"
    },
    "data_source": {
      "type": "string",
      "description": "Source system or import job that created this record"
    },
    "sync_last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when last seen during a sync operation"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "standings_hold": {
      "type": "boolean",
      "default": false,
      "description": "When true, standings recalculation skips this session."
    },
    "results_on_hold": {
      "type": "boolean",
      "default": false,
      "description": "When true, results are held pending official review."
    },
    "hold_reason": {
      "type": "string",
      "description": "Plain text reason for hold"
    },
    "hold_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "hold_released_at": {
      "type": "string",
      "format": "date-time"
    },
    "hold_released_by_user_id": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "R9CS: Whether this record is archived"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "R9CS: When this record was archived"
    },
    "archived_by": {
      "type": "string",
      "description": "R9CS: User ID who archived this record"
    },
    "archive_reason": {
      "type": "string",
      "description": "R9CS: Reason for archiving"
    }
  },
  "required": [
    "event_id",
    "session_type",
    "name"
  ]
}