{
  "name": "SeasonParticipation",
  "type": "object",
  "description": "One RacerProfile's competitive relationship to one Series during one season year and racer type \u2014 the authoritative season-specific competition context. Carries the season's class, team, car number and vehicle. A racer may hold several participations in one season; is_primary decides primary display only and never hides a secondary record. Thin model \u2014 no event-specific context. Intended resolver uniqueness key: racer_profile_id + series_id + season_year + racer_type. Compound unique constraints are not supported in Base44 entity schemas; uniqueness enforcement is deferred to the resolver function.",
  "properties": {
    "racecore_id": {
      "type": "string",
      "description": "Immutable RaceCore ID (PART + 9 digits). Backend-generated. Nullable in Phase 1 \u2014 not generated yet."
    },
    "racer_profile_id": {
      "type": "string",
      "description": "Reference to RacerProfile (required after backfill)"
    },
    "person_identity_id": {
      "type": "string",
      "description": "Denormalized derived reference to PersonIdentity. Must match the PersonIdentity linked through RacerProfile. Justified for query performance on career stats and INDEX46 profile queries."
    },
    "legacy_driver_id": {
      "type": "string",
      "description": "Transitional link to legacy Driver record. Nullable. Removed after full migration."
    },
    "series_id": {
      "type": "string",
      "description": "Reference to Series"
    },
    "series_class_id": {
      "type": "string",
      "description": "Reference to SeriesClass \u2014 the class this racer competes in for this series and season. Must belong to series_id. Nullable when the series has no class context."
    },
    "team_id": {
      "type": "string",
      "description": "Reference to Team for this series and season. Nullable \u2014 privateer entries have none."
    },
    "car_number": {
      "type": "string",
      "description": "Race number used in this series and season. Nullable \u2014 falls back to the legacy Driver primary_number for display."
    },
    "vehicle_id": {
      "type": "string",
      "description": "Reference to Vehicle used for this series and season. Nullable."
    },
    "season_year": {
      "type": "string",
      "description": "Normalized season year string such as '2026'. Not a reference to a Season entity \u2014 no Season entity exists in Phase 1."
    },
    "racer_type": {
      "type": "string",
      "enum": [
        "Driver",
        "Rider",
        "Pilot",
        "Co-driver",
        "Navigator",
        "Other"
      ],
      "default": "Driver",
      "description": "The competitor role for this participation"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Archived"
      ],
      "default": "Active",
      "description": "Participation lifecycle status"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Indicates primary participation when a racer has multiple in one season. Display preference only \u2014 never removes or hides a secondary participation."
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Archive flag"
    }
  },
  "required": [
    "racer_profile_id",
    "series_id",
    "season_year",
    "racer_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}