{
  "name": "AssetLink",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "driver",
        "team",
        "track",
        "series",
        "event",
        "session"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "primary": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "asset_id",
    "subject_type",
    "subject_id"
  ]
}