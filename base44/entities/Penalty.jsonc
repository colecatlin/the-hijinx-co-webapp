{
  "name": "Penalty",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "incident_id": {
      "type": "string",
      "description": "Source incident \u2014 optional for direct penalties"
    },
    "penalty_number": {
      "type": "string",
      "description": "PEN-001 per event \u2014 auto-assigned"
    },
    "penalty_type": {
      "type": "string",
      "enum": [
        "Position",
        "Time",
        "Points Deduction",
        "Warning",
        "Fine",
        "Probation",
        "Suspension",
        "Disqualification",
        "Drive-Through",
        "Stop-and-Go",
        "Grid Penalty",
        "Championship Points Deduction"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Proposed",
        "Approved",
        "Applied",
        "Under Appeal",
        "Overturned",
        "Upheld"
      ],
      "default": "Proposed"
    },
    "driver_id": {
      "type": "string"
    },
    "entry_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "rule_reference": {
      "type": "string",
      "description": "Rule code violated e.g. 10.4.2"
    },
    "position_delta": {
      "type": "number",
      "description": "Positions lost \u2014 positive integer"
    },
    "time_seconds": {
      "type": "number",
      "description": "Time added in seconds"
    },
    "points_deduction": {
      "type": "number",
      "description": "Championship points deducted"
    },
    "fine_amount": {
      "type": "number"
    },
    "fine_paid": {
      "type": "boolean",
      "default": false
    },
    "suspension_events": {
      "type": "number",
      "description": "Number of events suspended for"
    },
    "suspension_start_event_id": {
      "type": "string"
    },
    "probation_end_date": {
      "type": "string",
      "format": "date"
    },
    "proposed_by_user_id": {
      "type": "string"
    },
    "approved_by_user_id": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "applied_to_result_id": {
      "type": "string"
    },
    "original_position": {
      "type": "number"
    },
    "adjusted_position": {
      "type": "number"
    },
    "original_points": {
      "type": "number"
    },
    "adjusted_points": {
      "type": "number"
    },
    "affects_standings": {
      "type": "boolean",
      "default": true
    },
    "public_note": {
      "type": "string"
    },
    "internal_note": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "penalty_type",
    "driver_id",
    "reason"
  ]
}