{
  "name": "DisciplineColor",
  "type": "object",
  "properties": {
    "discipline": {
      "type": "string",
      "description": "Name of the racing discipline (e.g., 'Off Road', 'Stock Car')"
    },
    "color_code": {
      "type": "string",
      "description": "Hexadecimal color code for map pins (e.g., '#1E3A5F')"
    }
  },
  "required": [
    "discipline",
    "color_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}