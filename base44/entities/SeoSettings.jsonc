{
  "name": "SeoSettings",
  "type": "object",
  "description": "Presentation configuration for the HIJINX public site SEO (site-wide defaults, static page metadata, social sharing, canonical base URL, indexing controls). Single active record (is_active=true). Stores draft and published configuration separately \u2014 the public SeoMeta component reads only published; the Management editor works against draft. Does NOT duplicate entity content \u2014 provides defaults and overrides only. Follows the same singleton lifecycle as Home1Settings, NavigationSettings, and FooterSettings.",
  "properties": {
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Singleton marker \u2014 the active SEO settings record"
    },
    "draft": {
      "type": "object",
      "description": "Full draft SEO configuration (site, defaults, pages, indexing, sitemap). Edited by admins; not shown publicly until published."
    },
    "published": {
      "type": "object",
      "description": "Full published SEO configuration. The public SeoMeta component reads this. Copied from draft on publish."
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the published configuration was last published"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the draft was last saved"
    },
    "updated_by_user_id": {
      "type": "string",
      "description": "User ID of the last admin to save the draft or publish"
    },
    "has_unpublished_changes": {
      "type": "boolean",
      "default": false,
      "description": "True when draft differs from published \u2014 set on draft save, cleared on publish"
    }
  },
  "required": [
    "is_active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}