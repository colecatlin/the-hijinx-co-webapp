{
  "name": "Customer",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Linked Base44 User ID"
    },
    "email": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "default_shipping_address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepts_marketing": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "email"
  ]
}