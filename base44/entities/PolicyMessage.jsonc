{
  "name": "PolicyMessage",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "description": "Reference to PolicyThread"
    },
    "sender_user_id": {
      "type": "string",
      "description": "User id of the sender"
    },
    "message_text": {
      "type": "string",
      "description": "Message content"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "thread_id",
    "sender_user_id",
    "message_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.sender_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.sender_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}