{
  "name": "ImportedClassStaging",
  "type": "object",
  "properties": {
    "import_run_id": {
      "type": "string"
    },
    "source_class_name": {
      "type": "string"
    },
    "mapped_series_class_id": {
      "type": "string",
      "description": "Linked SeriesClass if matched"
    },
    "import_status": {
      "type": "string",
      "enum": [
        "pending",
        "matched",
        "created",
        "skipped",
        "conflict"
      ],
      "default": "pending"
    }
  },
  "required": [
    "import_run_id",
    "source_class_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}