{
  "name": "Discipline",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Canonical discipline name (e.g. 'Off Road', 'Stock Car')"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier (e.g. 'off-road')"
    },
    "color_code": {
      "type": "string",
      "description": "Hex color code for map pins and badges (e.g. '#1E3A5F')"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this discipline"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order \u2014 lower number appears first"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this discipline is active and selectable"
    }
  },
  "required": [
    "name",
    "color_code"
  ]
}