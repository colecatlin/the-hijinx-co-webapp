{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Human-readable order number"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "processing",
        "shipped",
        "delivered",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    },
    "subtotal": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "shipping_amount": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "discount_code": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "shipping_name": {
      "type": "string"
    },
    "shipping_address_line1": {
      "type": "string"
    },
    "shipping_address_line2": {
      "type": "string"
    },
    "shipping_city": {
      "type": "string"
    },
    "shipping_state": {
      "type": "string"
    },
    "shipping_zip": {
      "type": "string"
    },
    "shipping_country": {
      "type": "string",
      "default": "US"
    },
    "tracking_number": {
      "type": "string"
    },
    "tracking_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "fulfilled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_email",
    "status",
    "total",
    "currency"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}