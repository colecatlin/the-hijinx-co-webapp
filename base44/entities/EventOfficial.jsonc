{
  "name": "EventOfficial",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "Race Director",
        "Competition Director",
        "Chief Steward",
        "Steward",
        "Technical Director",
        "Technical Inspector",
        "Registration Manager",
        "Timing and Scoring",
        "Announcer",
        "Media Director",
        "Safety Director",
        "Gate Staff"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Invited",
        "Confirmed",
        "Active",
        "Withdrawn"
      ],
      "default": "Invited"
    },
    "assigned_by_user_id": {
      "type": "string"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "R9CS: Whether this record is archived"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "R9CS: When this record was archived"
    },
    "archived_by": {
      "type": "string",
      "description": "R9CS: User ID who archived this record"
    },
    "archive_reason": {
      "type": "string",
      "description": "R9CS: Reason for archiving"
    }
  },
  "required": [
    "event_id",
    "user_id",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}