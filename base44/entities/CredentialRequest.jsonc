{
  "name": "CredentialRequest",
  "type": "object",
  "properties": {
    "holder_media_user_id": {
      "type": "string"
    },
    "target_entity_type": {
      "type": "string",
      "enum": [
        "driver",
        "team",
        "track",
        "series",
        "event"
      ]
    },
    "target_entity_id": {
      "type": "string"
    },
    "related_event_id": {
      "type": "string"
    },
    "requested_access_level": {
      "type": "string",
      "enum": [
        "general",
        "pit",
        "hot_pit",
        "restricted",
        "drone",
        "all_access"
      ],
      "default": "general"
    },
    "requested_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "photographer",
          "videographer",
          "editor",
          "social",
          "writer",
          "other"
        ]
      },
      "default": []
    },
    "assignment_description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "applied",
        "change_requested",
        "under_review",
        "approved",
        "denied",
        "cancelled"
      ],
      "default": "draft"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "requester_profile_id": {
      "type": "string",
      "description": "MediaProfile ID of the requester \u2014 links request to media ecosystem"
    },
    "requester_outlet_id": {
      "type": "string",
      "description": "MediaOutlet ID if this request was submitted on behalf of an outlet"
    },
    "submission_source": {
      "type": "string",
      "enum": [
        "mediaportal",
        "racecore",
        "outlet_submission",
        "admin_created"
      ],
      "default": "racecore",
      "description": "Where this request originated"
    },
    "requested_scope": {
      "type": "string",
      "enum": [
        "event",
        "series",
        "season"
      ],
      "description": "Requested temporal scope of the credential"
    }
  },
  "required": [
    "holder_media_user_id",
    "target_entity_type",
    "target_entity_id",
    "status"
  ]
}