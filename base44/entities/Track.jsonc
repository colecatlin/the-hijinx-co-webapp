{
  "name": "Track",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Track name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "location_city": {
      "type": "string",
      "description": "City"
    },
    "location_state": {
      "type": "string",
      "description": "State or region"
    },
    "location_country": {
      "type": "string",
      "description": "Country"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude coordinate (from Google Places)"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude coordinate (from Google Places)"
    },
    "track_type": {
      "type": "string",
      "enum": [
        "Oval",
        "Road Course",
        "Street Circuit",
        "Short Track",
        "Speedway",
        "Off-Road",
        "Dirt Track",
        "Other"
      ],
      "description": "Type of track"
    },
    "surface_type": {
      "type": "string",
      "enum": [
        "Asphalt",
        "Concrete",
        "Dirt",
        "Clay",
        "Mixed"
      ],
      "description": "Track surface"
    },
    "length": {
      "type": "number",
      "description": "Track length in miles"
    },
    "banking": {
      "type": "string",
      "description": "Banking degrees or description"
    },
    "website_url": {
      "type": "string",
      "description": "Official website"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "description": {
      "type": "string",
      "description": "Track description"
    },
    "logo_url": {
      "type": "string",
      "description": "Track logo URL"
    },
    "image_url": {
      "type": "string",
      "description": "Track image URL"
    },
    "operational_status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Seasonal"
      ],
      "default": "Active",
      "description": "[RaceCore] Track's operational activity status."
    },
    "visibility_status": {
      "type": "string",
      "enum": [
        "draft",
        "live"
      ],
      "default": "draft",
      "description": "[Management] Controls public profile visibility."
    },
    "calendar_id": {
      "type": "string",
      "description": "Google Calendar ID for race schedule"
    },
    "numeric_id": {
      "type": "string",
      "description": "8-digit numeric access code"
    },
    "normalized_name": {
      "type": "string",
      "description": "Normalized lowercase name for deduplication"
    },
    "canonical_slug": {
      "type": "string",
      "description": "Canonical slug derived from normalized name for deduplication"
    },
    "canonical_key": {
      "type": "string",
      "description": "Canonical unique key for deduplication"
    },
    "data_source": {
      "type": "string",
      "description": "Source system or import job that created this record"
    },
    "external_uid": {
      "type": "string",
      "description": "UID from external data source for deduplication"
    },
    "sync_last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when last seen during a sync operation"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "R9CS: Whether this record is archived"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "R9CS: When this record was archived"
    },
    "archived_by": {
      "type": "string",
      "description": "R9CS: User ID who archived this record"
    },
    "archive_reason": {
      "type": "string",
      "description": "R9CS: Reason for archiving"
    },
    "bio": {
      "type": "string",
      "description": "Phase 15: Full public biography for the track"
    },
    "tagline": {
      "type": "string",
      "description": "Phase 15: Short headline or identity statement"
    },
    "hero_image_url": {
      "type": "string",
      "description": "Phase 15: Hero banner image for profile page (falls back to image_url)"
    },
    "map_image_url": {
      "type": "string",
      "description": "Phase 15: Track layout / configuration map image"
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Phase 15: Gallery of track image URLs"
    },
    "social_facebook": {
      "type": "string",
      "description": "Phase 15: Facebook URL"
    },
    "social_instagram": {
      "type": "string",
      "description": "Phase 15: Instagram handle or URL"
    },
    "social_x": {
      "type": "string",
      "description": "Phase 15: X (Twitter) handle or URL"
    },
    "social_youtube": {
      "type": "string",
      "description": "Phase 15: YouTube channel URL"
    },
    "social_tiktok": {
      "type": "string",
      "description": "Phase 15: TikTok handle or URL"
    },
    "address_line1": {
      "type": "string",
      "description": "Phase 15: Street address line 1"
    },
    "address_line2": {
      "type": "string",
      "description": "Phase 15: Street address line 2"
    },
    "zip_code": {
      "type": "string",
      "description": "Phase 15: Postal / ZIP code"
    },
    "elevation": {
      "type": "string",
      "description": "Phase 15: Elevation (e.g. '2,300 ft')"
    },
    "capacity": {
      "type": "number",
      "description": "Phase 15: Spectator capacity"
    },
    "configuration": {
      "type": "string",
      "description": "Phase 15: Track configuration description (e.g. '1.5-mile D-shaped oval, 17 turns road course')"
    },
    "time_zone": {
      "type": "string",
      "description": "Phase 15: IANA time zone (e.g. 'America/Chicago')"
    },
    "sanctioning_bodies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Phase 15: Sanctioning bodies that operate at this track"
    },
    "visitor_info": {
      "type": "object",
      "description": "Phase 15: Spectator and visitor information",
      "properties": {
        "camping": {
          "type": "string"
        },
        "parking": {
          "type": "string"
        },
        "hotels": {
          "type": "string"
        },
        "directions": {
          "type": "string"
        },
        "food": {
          "type": "string"
        },
        "accessibility": {
          "type": "string"
        },
        "amenities": {
          "type": "string"
        },
        "tickets_url": {
          "type": "string"
        },
        "weather": {
          "type": "string"
        }
      }
    },
    "timeline_milestones": {
      "type": "array",
      "default": [],
      "description": "Phase 15: Facility milestones (opened, expansions, renovations, ownership changes, historic races)",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "opened",
              "expansion",
              "renovation",
              "ownership",
              "historic_race",
              "anniversary",
              "national_event",
              "international_event",
              "milestone"
            ]
          }
        }
      }
    },
    "seo_title": {
      "type": "string",
      "description": "Phase 15: Optional SEO title override"
    },
    "seo_description": {
      "type": "string",
      "description": "Phase 15: Optional SEO meta description override"
    }
  },
  "required": [
    "name",
    "location_city",
    "location_country"
  ]
}