{
  "name": "HomepageSettings",
  "type": "object",
  "description": "Homepage configuration \u2014 image settings (key/image_url) and editorial override settings (active=true singleton)",
  "properties": {
    "key": {
      "type": "string",
      "description": "Section key for image background records (e.g. apparel_bg)"
    },
    "label": {
      "type": "string",
      "description": "Display label for image background records"
    },
    "image_url": {
      "type": "string",
      "description": "Background image URL for a section"
    },
    "active": {
      "type": "boolean",
      "default": false,
      "description": "If true, this is the active editorial settings singleton record"
    },
    "homepage_mode": {
      "type": "string",
      "enum": [
        "auto",
        "editorial",
        "mixed"
      ],
      "default": "mixed"
    },
    "featured_story_id": {
      "type": "string"
    },
    "featured_driver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "featured_track_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "featured_series_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "featured_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "featured_media_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "featured_product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "spotlight_driver_id": {
      "type": "string"
    },
    "spotlight_event_id": {
      "type": "string"
    },
    "ticker_override_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "hero_ticker_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "spotlight_mode": {
      "type": "string",
      "enum": [
        "auto",
        "manual",
        "mixed"
      ],
      "default": "mixed"
    },
    "featured_entities_mode": {
      "type": "string",
      "enum": [
        "auto",
        "manual",
        "mixed"
      ],
      "default": "mixed"
    },
    "activity_feed_mode": {
      "type": "string",
      "enum": [
        "auto",
        "manual",
        "mixed"
      ],
      "default": "auto"
    },
    "hero_overlay_alpha": {
      "type": "number",
      "default": 0.5,
      "description": "Hero tile background overlay opacity (0.0 = fully transparent, 1.0 = fully dark). Default 0.5."
    },
    "updated_by_user_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "social_instagram_url": {
      "type": "string"
    },
    "social_instagram_handle": {
      "type": "string"
    },
    "social_x_url": {
      "type": "string"
    },
    "social_x_handle": {
      "type": "string"
    },
    "social_facebook_url": {
      "type": "string"
    },
    "social_facebook_handle": {
      "type": "string"
    },
    "social_youtube_url": {
      "type": "string"
    },
    "social_youtube_handle": {
      "type": "string"
    },
    "social_tiktok_url": {
      "type": "string"
    },
    "social_tiktok_handle": {
      "type": "string"
    },
    "social_linkedin_url": {
      "type": "string"
    },
    "social_linkedin_handle": {
      "type": "string"
    },
    "social_threads_url": {
      "type": "string"
    },
    "social_threads_handle": {
      "type": "string"
    },
    "social_snapchat_url": {
      "type": "string"
    },
    "social_snapchat_handle": {
      "type": "string"
    },
    "social_discord_url": {
      "type": "string"
    },
    "social_discord_handle": {
      "type": "string"
    },
    "social_hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "apparel_shopify_url": {
      "type": "string",
      "default": "https://www.hijinxco.com"
    },
    "apparel_cta_label": {
      "type": "string",
      "default": "Shop HIJINX CO."
    },
    "apparel_link_strategy": {
      "type": "string",
      "enum": [
        "shopify",
        "internal"
      ],
      "default": "shopify"
    },
    "apparel_marketing_blocks": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "link_url": {
            "type": "string"
          },
          "accent_color": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}