{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "tagline": {
      "type": "string",
      "description": "Short product tagline shown under name"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "physical",
        "digital"
      ],
      "default": "physical"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "archived",
        "coming_soon",
        "sold_out"
      ],
      "default": "draft"
    },
    "description": {
      "type": "string",
      "description": "Full product description (rich text HTML)"
    },
    "short_description": {
      "type": "string",
      "description": "Short description for cards"
    },
    "story": {
      "type": "string",
      "description": "Product story/editorial text (rich text HTML)"
    },
    "fit_and_sizing": {
      "type": "string",
      "description": "Fit and sizing details"
    },
    "material_and_care": {
      "type": "string",
      "description": "Material composition and care instructions"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Primary cover image URL"
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery image URLs"
    },
    "lifestyle_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lifestyle/editorial imagery"
    },
    "price": {
      "type": "number",
      "description": "Base price"
    },
    "compare_at_price": {
      "type": "number",
      "description": "Original price for sale display"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "sku": {
      "type": "string",
      "description": "Base SKU"
    },
    "category": {
      "type": "string",
      "description": "Primary category"
    },
    "collection_id": {
      "type": "string",
      "description": "Primary Collection ID"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "feature_icons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Feature highlight icons (e.g. Moisture Wicking, 4-Way Stretch)"
    },
    "shipping_note": {
      "type": "string",
      "description": "Shipping info note displayed on PDP"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "product_type",
    "status",
    "price",
    "currency",
    "category"
  ]
}