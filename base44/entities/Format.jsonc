{
  "name": "Format",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Canonical format name (e.g. 'Road Course', 'Drag Racing')"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier (e.g. 'road-course')"
    },
    "discipline_id": {
      "type": "string",
      "description": "Reference to parent Discipline entity (required)"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this format"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within a Discipline \u2014 lower number appears first"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this format is active and selectable"
    }
  },
  "required": [
    "name",
    "discipline_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}