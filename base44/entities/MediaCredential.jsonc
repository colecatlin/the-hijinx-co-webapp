{
  "name": "MediaCredential",
  "type": "object",
  "properties": {
    "issuer_entity_type": {
      "type": "string",
      "enum": [
        "driver",
        "team",
        "track",
        "series",
        "event"
      ]
    },
    "issuer_entity_id": {
      "type": "string"
    },
    "holder_media_user_id": {
      "type": "string"
    },
    "scope_entity_type": {
      "type": "string",
      "enum": [
        "driver",
        "team",
        "track",
        "series",
        "event"
      ]
    },
    "scope_entity_id": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "photographer",
          "videographer",
          "editor",
          "social",
          "writer",
          "other"
        ]
      },
      "default": []
    },
    "access_level": {
      "type": "string",
      "enum": [
        "general",
        "pit",
        "hot_pit",
        "restricted",
        "drone",
        "all_access"
      ],
      "default": "general"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked",
        "expired"
      ],
      "default": "pending"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by_user_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "requester_profile_id": {
      "type": "string",
      "description": "MediaProfile ID of the credential holder \u2014 links to media ecosystem"
    },
    "requester_outlet_id": {
      "type": "string",
      "description": "MediaOutlet ID if this credential was obtained through an outlet"
    },
    "approved_for_entity_type": {
      "type": "string",
      "enum": [
        "user",
        "outlet",
        "team",
        "driver",
        "media_group"
      ],
      "description": "Type of platform entity this credential was approved for"
    },
    "approved_for_entity_id": {
      "type": "string",
      "description": "ID of the entity this credential was approved for"
    },
    "credential_scope": {
      "type": "string",
      "enum": [
        "event",
        "series",
        "season"
      ],
      "description": "Temporal/structural scope of this credential"
    },
    "credential_level": {
      "type": "string",
      "enum": [
        "limited",
        "standard",
        "full_access",
        "pit_lane",
        "media_center",
        "broadcast"
      ],
      "description": "Platform-level credential access tier"
    }
  },
  "required": [
    "holder_media_user_id",
    "scope_entity_type",
    "scope_entity_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}