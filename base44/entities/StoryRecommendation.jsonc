{
  "name": "StoryRecommendation",
  "type": "object",
  "properties": {
    "title_suggestion": {
      "type": "string",
      "description": "Suggested headline or title for the story"
    },
    "slug_suggestion": {
      "type": "string",
      "description": "Suggested URL slug"
    },
    "summary": {
      "type": "string",
      "description": "Short summary of the recommended story"
    },
    "angle": {
      "type": "string",
      "description": "Editorial angle or framing for the story"
    },
    "why_now": {
      "type": "string",
      "description": "Explanation of why this story is timely right now"
    },
    "story_type": {
      "type": "string",
      "enum": [
        "feature",
        "news",
        "analysis",
        "opinion",
        "profile",
        "race_report",
        "data_story",
        "photo_essay",
        "other"
      ],
      "description": "Type of story recommended"
    },
    "recommended_format": {
      "type": "string",
      "enum": [
        "short",
        "long_form",
        "photo_led",
        "data_led",
        "video",
        "podcast"
      ],
      "description": "Recommended content format"
    },
    "target_reader": {
      "type": "string",
      "description": "Description of the target reader/audience for this story"
    },
    "publish_timing": {
      "type": "string",
      "description": "Suggested timing or window to publish"
    },
    "recommended_category": {
      "type": "string",
      "enum": [
        "Racing",
        "Business",
        "Culture",
        "Tech",
        "Media",
        "Marketplace"
      ],
      "description": "Recommended primary category"
    },
    "recommended_subcategory": {
      "type": "string",
      "description": "Recommended sub-category"
    },
    "recommended_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggested tags for this story"
    },
    "seo_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggested SEO keywords"
    },
    "suggested_headline_alt_1": {
      "type": "string"
    },
    "suggested_headline_alt_2": {
      "type": "string"
    },
    "suggested_excerpt": {
      "type": "string"
    },
    "draft_intro": {
      "type": "string"
    },
    "draft_outline": {
      "type": "string"
    },
    "priority_score": {
      "type": "number",
      "description": "Priority score 0-100"
    },
    "urgency_score": {
      "type": "number",
      "description": "Urgency score 0-100"
    },
    "confidence_score": {
      "type": "number",
      "description": "AI confidence score 0-100"
    },
    "newsworthiness_score": {
      "type": "number",
      "description": "Newsworthiness 0-100"
    },
    "coverage_gap_score": {
      "type": "number",
      "description": "Coverage gap 0-100"
    },
    "status": {
      "type": "string",
      "enum": [
        "suggested",
        "saved",
        "approved",
        "assigned",
        "in_progress",
        "ready_for_review",
        "needs_revision",
        "drafted",
        "published",
        "dismissed",
        "covered"
      ],
      "default": "suggested",
      "description": "Editorial workflow status"
    },
    "recommendation_fingerprint": {
      "type": "string",
      "description": "Deduplication fingerprint"
    },
    "cooldown_until": {
      "type": "string",
      "format": "date-time",
      "description": "Suppress new recommendations until this time"
    },
    "follow_up_story_flag": {
      "type": "boolean",
      "default": false
    },
    "story_gap_detected": {
      "type": "boolean",
      "default": false
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "related_entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_entity_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_signal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of ContentSignals that triggered this recommendation"
    },
    "trend_cluster_id": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of assigned writer/editor"
    },
    "editor_notes": {
      "type": "string"
    },
    "writer_notes": {
      "type": "string",
      "description": "Internal notes from the assigned writer"
    },
    "linked_story_id": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "converted_to_draft_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title_suggestion",
    "status"
  ]
}